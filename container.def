Bootstrap: docker
From: ubuntu:22.04

%setup
    # Execute commands on the host system outisde of the container

%files
    # List fo files to copy to the container filesystem e.g. src dest
    /home/kenil/PhD/Software/GLEAM-X-pipeline/data/pb/gleam_xx_yy.hdf5 /data/gleam_xx_yy.hdf5
    /home/kenil/PhD/Software/GLEAM-X-pipeline/data/pb/gleam_jones.hdf5 /data/gleam_jones.hdf5
    /home/kenil/PhD/Software/Documents/MWA-GPM-data/atnf_pulsar_cat.fits /data/atnf_pulsar_cat.fits
    /home/kenil/PhD/Software/Documents/MWA-GPM-data/GLEAM_GP.fits /data/GLEAM_GP.fits
    /home/kenil/PhD/Software/Documents/Transients/container_modules /modules
    /home/kenil/PhD/Software/GLEAM-X-pipeline/models/GGSM.fits /data/GGSM.fits

%environment
    # Environemtn variables set at runtime (not available at build time)
    export MWA_PB_BEAM=/data/gleam_xx_yy.hdf5
    export MWA_PB_JONES=/data/gleam_jones.hdf
    export ATNF_PULSAR_CAT=/data/atnf_pulsar_cat.fits
    export GLEAM_GP=/data/GLEAM_GP.fits
    export GGSM=/data/GGSM.fits

%post
    # Commands run at build time within the container
    export DEBIAN_FRONTEND=noninteractive
    chmod -R o+rX /data/*

    apt-get -y update
    apt-get -y install git-all
    apt-get -y install imagemagick
    apt-get -y install python3
    apt-get -y install python3-pip

    apt-get -y install python3-numpy \
                       python3-scipy \
                       python3-astropy \
                       python3-matplotlib \
                       python3-h5py \
                       python3-reproject \
                       python3-astroquery \
                       python3-pandas

    pip install /modules/mwa_pb_lookup
    pip install /modules/GLEAM-X-pipeline
    pip install /modules/lowner_john_ellipse
    rm -r /modules

%runscript
    # Commands executed when the container is run directly

%startscript
    #Executed when the instance start command is issued i.e. singularity instance start container.sif instance1

%test
    # Executed at the end of the build process to validate the container
    # or when the test command is issued i.e. singularity test container.sif

%labels
    # metadata as key value pairs. Show using singularity inspect container.sif

%help
    # Test to show when help command is issued
